# MAX
MAX_BOT_TOKEN=put_max_bot_token_here
MAX_WEBHOOK_SECRET=change_me_please
MAX_WEBHOOK_URL=https://your-domain.ru/webhook
MAX_API_BASE=https://platform-api2.max.ru

# Runtime mode: auto / polling / webhook
# auto = Long Polling on Bothost Basic/Start/Free, webhook on paid plans
BOT_MODE=auto

# DeepSeek official API
DEEPSEEK_API_KEY=put_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Bot behavior
MAX_REPLY_FORMAT=markdown
MAX_OUTPUT_CHUNK=3900
HISTORY_MESSAGES=12
IMAGE_DETAIL=original
LOG_LEVEL=INFO
